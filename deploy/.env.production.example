# ==============================================================================
# Production Environment Configuration Template
# ==============================================================================
# Usage:
#   1. Copy this template to ../.env (or your server's secure configuration path).
#   2. Replace all <PLACEHOLDERS> with your actual environment configuration.
#   3. Secure permissions: chmod 600 ../.env (readable only by the service user).
#   4. NEVER commit actual production secrets to version control.
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
# NEVER enable DEBUG in production. Keep strictly False.
DEBUG=False

# Cryptographically secure random secret key (minimum 50 characters).
# Generate via: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=<SECRET_KEY_MIN_50_CHARACTERS>

# Comma-separated list of allowed Host header domains and private IP addresses.
# Must include your public API domain, local loopback, and internal network IP.
ALLOWED_HOSTS=<API_DOMAIN>,127.0.0.1,localhost,<BACKEND_INTERNAL_IP>

# Explicit production settings module definition
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Primary Database (PostgreSQL - Managed / Dedicated) ───────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=5432

# Connection persistence in seconds (reduces socket reconnection overhead)
DB_CONN_MAX_AGE=60

# ── FreeRADIUS Database (PostgreSQL - Dedicated / External) ───────────────────
# If sharing the main database, these can match DB_* values above.
# If using a separate database (e.g. Railway or dedicated DB server):
RADIUS_DB_ENGINE=django.db.backends.postgresql
RADIUS_DB_NAME=<RADIUS_DB_NAME>
RADIUS_DB_USER=<RADIUS_DB_USER>
RADIUS_DB_PASSWORD=<RADIUS_DB_PASSWORD>
RADIUS_DB_HOST=<RADIUS_DB_HOST>
RADIUS_DB_PORT=<RADIUS_DB_PORT>

# ── CORS & CSRF (Frontend Domain Allowlist) ──────────────────────────────────
# Comma-separated origins permitted for cross-origin AJAX/fetch requests from web frontends
CORS_ALLOWED_ORIGINS=https://<FRONTEND_APP_DOMAIN>,https://<ADMIN_APP_DOMAIN>

# Comma-separated origins permitted for state-changing HTTPS requests (POST, PUT, DELETE)
CSRF_TRUSTED_ORIGINS=https://<API_DOMAIN>,https://<FRONTEND_APP_DOMAIN>,https://<ADMIN_APP_DOMAIN>

# ── Reverse Proxy & Transport Security (Cloudflare / Nginx) ───────────────────
# Enforce HTTPS redirect (handled via X-Forwarded-Proto from reverse proxy)
SECURE_SSL_REDIRECT=True

# Protect authentication session and CSRF cookies (HTTPS only)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) - enforce HTTPS for 1 year across all subdomains
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── MikroTik RouterOS Defaults ────────────────────────────────────────────────
# Default API-SSL port and certificate verification behavior for router communication
MIKROTIK_DEFAULT_PORT=443
MIKROTIK_SSL_VERIFY=False

# Validity window in minutes for one-time router provisioning download tokens
SCRIPT_TOKEN_EXPIRATION_MINUTES=10

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Firebase Push Notifications (Optional) ───────────────────────────────────
# Absolute path to Google Firebase service-account.json (leave blank if not using Firebase)
FIREBASE_CREDENTIALS_PATH=<PATH_TO_FIREBASE_CREDENTIALS_JSON>

# ── Email Relay (SMTP Relay / Brevo) ──────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<SMTP_USER>
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
DEFAULT_FROM_EMAIL="<SENDER_NAME> <noreply@<YOUR_DOMAIN>>"
EMAIL_OTP_EXPIRATION_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# ── Optional Gunicorn Server Tuning ──────────────────────────────────────────
# GUNICORN_BIND=<BACKEND_INTERNAL_IP>:8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_LOGLEVEL=info
