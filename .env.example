# ── Django ─────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=<SECRET_KEY_MIN_50_CHARACTERS>
# Comma-separated domain names and/or server IP:
ALLOWED_HOSTS=<API_DOMAIN>,localhost,127.0.0.1,<BACKEND_INTERNAL_IP>

# ── Database (PostgreSQL - Local Docker or Managed) ────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=127.0.0.1
DB_PORT=5432
# Keep connection alive for N seconds (reduces connection churn)
DB_CONN_MAX_AGE=60

# ── FreeRADIUS Database (Optional separate database) ──────────────────────────
# If omitted, falls back to the main database credentials above
RADIUS_DB_ENGINE=django.db.backends.postgresql
RADIUS_DB_NAME=<RADIUS_DB_NAME>
RADIUS_DB_USER=<RADIUS_DB_USER>
RADIUS_DB_PASSWORD=<RADIUS_DB_PASSWORD>
RADIUS_DB_HOST=<RADIUS_DB_HOST>
RADIUS_DB_PORT=5432

# ── CORS & CSRF (Frontend Domains & Proxy) ────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://<FRONTEND_APP_DOMAIN>
CSRF_TRUSTED_ORIGINS=https://<API_DOMAIN>,https://<FRONTEND_APP_DOMAIN>

# ── Production Security (Reverse Proxy / Cloudflare) ──────────────────────────
# Set to False if SSL termination is tested locally over HTTP without proxy
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── MikroTik defaults (can be overridden per-router from the DB) ───────────────
MIKROTIK_DEFAULT_PORT=443
MIKROTIK_SSL_VERIFY=False

# ── RouterOS Script Provisioning ──────────────────────────────────────────────
SCRIPT_TOKEN_EXPIRATION_MINUTES=10

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Firebase (Optional: path to service-account.json) ─────────────────────────
FIREBASE_CREDENTIALS_PATH=<PATH_TO_FIREBASE_CREDENTIALS_JSON>

# ── Email (SMTP Relay / Brevo) ────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<SMTP_USER>
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
DEFAULT_FROM_EMAIL="<SENDER_NAME> <noreply@<YOUR_DOMAIN>>"
EMAIL_OTP_EXPIRATION_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
