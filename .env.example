# ── Django ─────────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=wifi_tickets
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=127.0.0.1
DB_PORT=5432

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── MikroTik defaults (can be overridden per-router from the DB) ───────────────
MIKROTIK_DEFAULT_PORT=443
MIKROTIK_SSL_VERIFY=False

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email (Brevo SMTP Relay) ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-master-password
DEFAULT_FROM_EMAIL="WiFi Tickets <noreply@yourdomain.com>"
EMAIL_OTP_EXPIRATION_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
