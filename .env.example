# ── Django ─────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-50-character-secret-in-production
# In production, include domain names and/or server IP (comma-separated):
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL - Local Docker or Railway) ────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hookcode_db
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=127.0.0.1
DB_PORT=5432
# Keep connection alive for N seconds (reduces Railway connection churn)
DB_CONN_MAX_AGE=60

# ── FreeRADIUS Database (Optional separate database) ──────────────────────────
# If omitted, falls back to the main database credentials above
RADIUS_DB_ENGINE=django.db.backends.postgresql
RADIUS_DB_NAME=radius
RADIUS_DB_USER=postgres
RADIUS_DB_PASSWORD=mysecretpassword
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=5432

# ── CORS & CSRF (Frontend Domains & Cloudflare) ────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Production Security (Nginx / Cloudflare) ──────────────────────────────────
# Set to False if SSL termination is tested locally over HTTP without proxy
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── MikroTik defaults (can be overridden per-router from the DB) ───────────────
MIKROTIK_DEFAULT_PORT=443
MIKROTIK_SSL_VERIFY=False

# ── RouterOS Script Provisioning ──────────────────────────────────────────────
SCRIPT_TOKEN_EXPIRATION_MINUTES=10

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Firebase (Optional: path to service-account.json) ─────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ── Email (Brevo SMTP Relay) ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="WiFi Tickets <noreply@hookcode.com>"
EMAIL_OTP_EXPIRATION_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
