#: rest_framework
msgid "This field is required."
msgstr "Este campo es requerido."

#: apps/hotspot/serializers.py:113
msgid "Filename must not contain path separators ('/' or '\\')."
msgstr "El nombre de archivo no debe contener separadores de ruta ('/' o '\\')."

#: apps/hotspot/views.py:156
msgid "'router' query param is required."
msgstr "El parámetro de consulta 'router' es obligatorio."

#: apps/routers/permissions.py:53
msgid "You must be the owner of this router to perform this action."
msgstr "Debes ser el propietario de este router para realizar esta acción."

#: apps/routers/permissions.py:71
msgid "You do not have access to this router."
msgstr "No tienes acceso a este router."

#: apps/routers/serializers.py:96
msgid "This user already has a role assigned for the selected router."
msgstr "Este usuario ya tiene un rol asignado para el router seleccionado."

#: apps/tickets/views.py:96
#, python-format
msgid "Only PENDING tickets can be cancelled. Current status: %(status)s"
msgstr "Solo los tickets PENDIENTES pueden ser cancelados. Estado actual: %(status)s"

#: apps/users/firebase.py:18
#, python-format
msgid "Invalid Firebase ID token: %(error)s"
msgstr "Token de ID de Firebase inválido: %(error)s"

#: apps/users/serializers.py:33
msgid "Passwords do not match."
msgstr "Las contraseñas no coinciden."

#: apps/users/serializers.py:50
msgid "New passwords do not match."
msgstr "Las nuevas contraseñas no coinciden."

#: apps/users/serializers.py:60
msgid "The Firebase ID token obtained from Google Sign-In."
msgstr "El token de ID de Firebase obtenido desde el inicio de sesión con Google."

#: apps/users/views.py:80
msgid "Old password is incorrect."
msgstr "La contraseña anterior es incorrecta."

#: apps/users/views.py:86
msgid "Password updated successfully."
msgstr "Contraseña actualizada exitosamente."

#: apps/users/views.py:105
msgid "Email is missing from the Google token."
msgstr "El correo electrónico no está presente en el token de Google."

#: config/settings/base.py:114
msgid "English"
msgstr "Inglés"

#: config/settings/base.py:115
msgid "Spanish"
msgstr "Español"

#: apps/scripts/views.py:57
msgid "You must be the owner of this router to generate download tokens."
msgstr "Debes ser el propietario de este router para generar tokens de descarga."

#: apps/scripts/views.py:122
msgid "The provisioning script link is invalid, has expired, or has already been used."
msgstr "El enlace de script de aprovisionamiento es inválido, ha expirado o ya ha sido utilizado."

